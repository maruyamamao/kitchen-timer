<Window x:Class="キッチンタイマー_1D25IS_丸山_Alarm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kitchen Timer" Height="650" Width="380" MinHeight="600" MinWidth="350"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="#E9E8E3">
    
    <!-- ボタンの共通デザイン -->
    <!-- ウィンドウ内で使う共通の設定を定義する場所 -->
        <Window.Resources>
            
        <!-- x:Keyがスタイルにつける名前、ボタンに適用するスタイル -->
            <Style x:Key="NumberButtonStyle" TargetType="Button">

            <!-- Setter：プロパティに値を設定するための要素 -->
            <!-- Marginの余白の大きさを４に設定 -->
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
                
            <!-- ボタンの文字色を設定 -->
            <Setter Property="Foreground" Value="#34453C"/>
            <Setter Property="Background" Value="#FFFFFF"/>
                
            <!-- ボタンの枠線の色を設定 -->
            <Setter Property="BorderBrush" Value="#D2D2CA"/>
                
            <!-- 枠線の太さを１に設定 -->
            <Setter Property="BorderThickness" Value="1"/>
                
            <!-- ボタンの中身を横方向の中央に配置する設定 -->
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                
            <!-- ボタンの中身を縦方向の中央に配置する設定 -->
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 機能ボタン用のスタイルを定義 -->
        <Style x:Key="FunctionButtonStyle" TargetType="Button" BasedOn="{StaticResource NumberButtonStyle}">
            <Setter Property="Background" Value="#D6D8D0"/>
            <Setter Property="FontSize" Value="21"/>
        </Style>
            
        <!-- クリアボタン用のスタイルを定義 -->
        <!-- BasedOn="{StaticResource NumberButtonStyle}"：数字ボタン用のスタイルを引き継ぐ -->
        <Style x:Key="ClearButtonStyle" TargetType="Button" BasedOn="{StaticResource NumberButtonStyle}">
            <Setter Property="Background" Value="#D9B4A7"/>
            <Setter Property="Foreground" Value="#713D32"/>
            <Setter Property="FontSize" Value="21"/>
        </Style>
    </Window.Resources>

    <!-- 画面全体 -->
    <Grid Margin="18">
        
        <!-- Gridを縦方向に分割するための行定義 -->
        <Grid.RowDefinitions>
            
            <!-- タイトル -->
            <RowDefinition Height="Auto"/>
            
            <!-- 時間表示 -->
            <RowDefinition Height="Auto"/>
            
            <!-- 数字ボタンと操作ボタン -->
            <!-- Height="*" は、ほかの行が必要な高さを確保したあと、残った高さを使う設定 -->
            <RowDefinition Height="*"/>
            
            <!-- アラーム停止 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- タイトル -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12" HorizontalAlignment="Center">
            <TextBlock Text="KITCHEN TIMER" FontSize="23" FontWeight="Bold" Foreground="#34453C" HorizontalAlignment="Center"/>
            <TextBlock Text="キッチンタイマー" FontSize="12" Foreground="#777D78" HorizontalAlignment="Center" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- 時間表示 -->
        <Border Grid.Row="1" Background="#26352D" CornerRadius="12" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="REMAINING TIME" FontSize="11" Foreground="#AAB8A8" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock x:Name="txtTime" Text="00:00" FontSize="52" FontWeight="Bold" FontFamily="Consolas" Foreground="#D8F0B5" HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 数字ボタンと操作ボタンのエリア -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <!-- 数字ボタンが残りの高さを使う -->
                <RowDefinition Height="*"/>
                <!-- 操作ボタンは必要な高さを確保 -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 数字ボタン -->
            <!-- UniformGrid：子要素を均等なマス目に並べるレイアウト要素 -->
            <UniformGrid x:Name="keypadGrid" Grid.Row="0" Columns="3" Rows="4">
                <Button Content="7" Click="NumberButton_Click" Style="{StaticResource NumberButtonStyle}"/>
                <Button Content="8" Click="NumberButton_Click" Style="{StaticResource NumberButtonStyle}"/>
                <Button Content="9" Click="NumberButton_Click" Style="{StaticResource NumberButtonStyle}"/>
                <Button Content="4" Click="NumberButton_Click" Style="{StaticResource NumberButtonStyle}"/>
                <Button Content="5" Click="NumberButton_Click" Style="{StaticResource NumberButtonStyle}"/>
                <Button Content="6" Click="NumberButton_Click" Style="{StaticResource NumberButtonStyle}"/>
                <Button Content="1" Click="NumberButton_Click" Style="{StaticResource NumberButtonStyle}"/>
                <Button Content="2" Click="NumberButton_Click" Style="{StaticResource NumberButtonStyle}"/>
                <Button Content="3" Click="NumberButton_Click" Style="{StaticResource NumberButtonStyle}"/>
                <Button Content="⌫" Click="BackspaceButton_Click" Style="{StaticResource FunctionButtonStyle}"/>
                <Button Content="0" Click="NumberButton_Click" Style="{StaticResource NumberButtonStyle}"/>
                <Button Content="C" Click="ClearButton_Click" Style="{StaticResource ClearButtonStyle}"/>
            </UniformGrid>

            <!-- 操作ボタン：数字ボタンのすぐ下 -->
            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnStart" Grid.Column="0" Content="▶ スタート" Click="btnStart_Click" Margin="3" Padding="3,14" Background="#527A5C" Foreground="White" FontSize="13" FontWeight="Bold"/>
                <Button x:Name="btnStop" Grid.Column="1" Content="Ⅱ ストップ" Click="btnStop_Click" Margin="3" Padding="3,14" Background="#C8A15A" Foreground="White" FontSize="13" FontWeight="Bold" IsEnabled="False"/>
                <Button x:Name="btnReset" Grid.Column="2" Content="↻ リセット" Click="btnReset_Click" Margin="3" Padding="3,14" Background="#777D78" Foreground="White" FontSize="13" FontWeight="Bold"/>
            </Grid>
        </Grid>

        <!-- アラーム停止 -->
        <Button x:Name="btnAlarmStop" Grid.Row="3" Content="🔔 アラーム停止" Click="btnAlarmStop_Click" Padding="10,13" Background="#B45F50" Foreground="White" FontSize="15" FontWeight="Bold" IsEnabled="False"/>
    </Grid>
</Window>